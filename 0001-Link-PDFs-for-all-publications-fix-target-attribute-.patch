From 6337cc33a4b2b25bd82f2d17233139e7f841082f Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Tue, 3 Nov 2026 23:05:14 +0000
Subject: [PATCH] Link PDFs for all publications; fix target attribute on links

- Add links for the 13 papers that had none: ACL Anthology PDFs for
  the 9 ACL/LREC/EMNLP/IJCNLP/BabyLM papers, arXiv for the LRE paper,
  ensani.ir for the Language and Linguistics paper, and DOI pages for
  the paywalled CHB and TCAD papers.
- jemdoc wrote target="blank" with unescaped quotes, which its
  smart-quote pass turned into curly quotes, producing invalid HTML
  on every content link. Escape them like href.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_0153Na3yQADfLT3W7qvNFLp9
---
 src/jemdoc.py                      |  2 +-
 src/publications_by_subject.jemdoc | 26 +++++++++++++-------------
 src/publications_by_type.jemdoc    | 26 +++++++++++++-------------
 3 files changed, 27 insertions(+), 27 deletions(-)

diff --git a/src/jemdoc.py b/src/jemdoc.py
index 5853dfa..8e3bb73 100755
--- a/src/jemdoc.py
+++ b/src/jemdoc.py
@@ -675,7 +675,7 @@ def replacelinks(b):
         option = ''
         m1 = m1[1:]
     else:
-        option = ' target="blank"'
+        option = r' target=\"blank\"'
 
     if '@' in m1 and not m1.startswith('mailto:') and not \
        m1.startswith('http://'):
diff --git a/src/publications_by_subject.jemdoc b/src/publications_by_subject.jemdoc
